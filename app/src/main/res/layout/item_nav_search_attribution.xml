<?xml version="1.0" encoding="utf-8"?>
<!--
  RoadSense map — Google Maps attribution row appended by NavSearchResultAdapter
  under Google-sourced search results. Not clickable; the plain (non-outlined)
  logo suits the dropdown's plain surface. Gray/white is picked in code by uiMode.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivSearchAttributionLogo"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_gravity="start|center_vertical"
        android:adjustViewBounds="true"
        android:contentDescription="@string/navmap_google_maps_cd"
        android:scaleType="fitStart"
        android:src="@drawable/google_maps_logo_gray" />

</FrameLayout>
