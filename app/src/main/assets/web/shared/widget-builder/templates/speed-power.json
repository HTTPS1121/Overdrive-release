    { "type": "text", "name": "Power", "x": 26, "y": 160, "size": 15, "weight": 600,
      "text": "=power < 0 ? 'Regen ' + fmt(-power) + ' kW' : fmt(power) + ' kW'", "color": "=power < 0 ? regenText : text2" },
    { "type": "text", "name": "Trace caption", "x": 376, "y": 160, "size": 13, "weight": 500, "align": "right", "text": "last 60 s", "color": "text3" }
  ]
}
